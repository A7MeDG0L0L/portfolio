---
interface Props { label: string }
const { label } = Astro.props;
---
<button type="button" class="theme-toggle" data-testid="theme-toggle" aria-label={label} title={label}>
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></g></svg>
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-testid="theme-toggle"]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch { /* storage blocked: theme still applies for this view */ }
    });
  });
</script>

<style>
  .theme-toggle { display: inline-grid; place-items: center; width: 38px; height: 38px; border-radius: 12px; border: 1px solid var(--line); background: var(--panel); color: var(--text); cursor: pointer; }
  .theme-toggle:hover { border-color: var(--muted); }
  :global([data-theme="dark"]) .moon, :global([data-theme="light"]) .sun { display: none; }
</style>
