---
import { getSkills, getCertifications } from '../../lib/content';
import { formatMonth } from '../../lib/format';
import { t } from '../../i18n/utils';
import type { Locale } from '../../i18n/locales';
interface Props { locale: Locale }
const { locale } = Astro.props;
const { groups } = await getSkills(locale);
const { items } = await getCertifications(locale);
---
<section id="skills" class="section container-x" aria-labelledby="skills-title">
  <p class="eyebrow">{t(locale, 'skills')}</p>
  <h2 class="h2" id="skills-title">{t(locale, 'skills')} & {t(locale, 'certifications')}</h2>
  <div class="cols">
    <div class="groups">
      {groups.map((g) => (
        <div class="group reveal"><h3>{g.name}</h3><ul class="chips">{g.items.map((i) => <li>{i}</li>)}</ul></div>
      ))}
    </div>
    <ul class="certs">
      {items.map((c) => (
        <li class="card cert reveal">
          <p class="dates">{c.issuer} · {formatMonth(c.start, locale)} – {formatMonth(c.end, locale)}</p>
          <h3>{c.title}</h3>
          <p>{c.description}</p>
          {c.url && <a href={c.url} target="_blank" rel="noopener">{t(locale, 'viewCertificate')} <span class="flip" aria-hidden="true">↗</span></a>}
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .cols { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: start; }
  .groups { display: grid; gap: 18px; }
  .group h3 { font-size: 14px; color: var(--muted); font-weight: 600; margin: 0 0 8px; }
  .certs { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .cert { padding: 18px 20px; }
  .cert h3 { font-size: 16px; margin: 4px 0 6px; }
  .cert p { color: var(--muted); font-size: 14px; line-height: 1.5; margin: 0; }
  .cert .dates { font-size: 12px; }
  .cert a { display: inline-block; margin-top: 10px; color: var(--accent); font-size: 14px; font-weight: 600; }
  @media (max-width: 899px) { .cols { grid-template-columns: 1fr; } }
</style>
