---
import { localizePath } from '../../i18n/utils';
import type { Locale } from '../../i18n/locales';
interface Props { title: string; description: string; locale: Locale; ogImage?: string }
const { title, description, locale, ogImage = '/og.png' } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const abs = (p: string) => new URL(p, site).href;
const path = Astro.url.pathname;
const enPath = localizePath(path, 'en');
const arPath = localizePath(path, 'ar');
---
<link rel="canonical" href={abs(path)} />
<link rel="alternate" hreflang="en" href={abs(enPath)} />
<link rel="alternate" hreflang="ar" href={abs(arPath)} />
<link rel="alternate" hreflang="x-default" href={abs(enPath)} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={abs(path)} />
<meta property="og:image" content={abs(ogImage)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={locale === 'ar' ? 'ar_EG' : 'en_US'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={abs(ogImage)} />
<meta name="theme-color" content="#0b0d12" />
