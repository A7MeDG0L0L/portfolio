---
import type { Project } from '../../lib/projects';
interface Props { project: Project; size: 'card' | 'hero' }
const { project, size } = Astro.props;
const { icon, screenshots, title } = project.data;
const shot = screenshots[0];
---
<div class:list={['cover', size]} style={`--cover-bg:${icon.bg};--cover-fg:${icon.fg ?? '#fff'}`}>
  {shot
    ? <img src={shot.src} alt={shot.alt} loading="lazy" decoding="async" />
    : <span class="label" aria-hidden="true">{icon.label}</span>}
  {!shot && <span class="sr-only">{title}</span>}
</div>
<style>
  .cover { position: relative; display: grid; place-items: center; overflow: hidden; background: var(--cover-bg); color: var(--cover-fg); }
  .cover::after { content: ""; position: absolute; inset: 0; background: linear-gradient(160deg, transparent 30%, rgba(0,0,0,.35)); pointer-events: none; }
  .card { aspect-ratio: 16 / 10; border-radius: 18px; }
  .hero { aspect-ratio: 16 / 5; max-height: 300px; width: 100%; border-radius: 28px; }
  .label { font-weight: 800; font-size: 44px; letter-spacing: -.02em; z-index: 1; }
  .hero .label { font-size: 72px; }
  img { width: 100%; height: 100%; object-fit: cover; }
</style>
