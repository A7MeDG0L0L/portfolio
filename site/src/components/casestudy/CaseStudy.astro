---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Contact from '../sections/Contact.astro';
import Cover from './Cover.astro';
import { getProfile } from '../../lib/content';
import { getProjects, hasCaseStudyPage, type Project } from '../../lib/projects';
import { t, localizePath, altLocalePath } from '../../i18n/utils';
import type { UiKey } from '../../i18n/ui';
import type { Locale } from '../../i18n/locales';
interface Props { project: Project; locale: Locale }
const { project, locale } = Astro.props;
const d = project.data;
const profile = await getProfile(locale);
const { Content } = await render(project);
const list = (await getProjects(locale)).filter(hasCaseStudyPage);
const i = list.findIndex((p) => p.data.slug === d.slug);
const prev = list[i - 1];
const next = list[i + 1];
const home = localizePath('/', locale);
const linkLabels: Record<string, UiKey> = { play: 'linkPlay', appStore: 'linkAppStore', github: 'linkGithub', pubdev: 'linkPubdev', web: 'linkWeb' };
const links = Object.entries(d.links).filter(([, url]) => Boolean(url)) as [string, string][];
const meta = [d.company, d.dates].filter(Boolean).join(' · ');
---
<Base title={`${d.title} — ${profile.name}`} description={d.summary} locale={locale} altPath={altLocalePath(Astro.url)}>
  <Nav locale={locale} />
  <main id="main" class="container-x cs">
    <a class="backlink" href={`${home}#work`}><span class="flip" aria-hidden="true">←</span> {t(locale, 'backToWork')}</a>
    <Cover project={project} size="hero" />
    <header class="head">
      {meta && <p class="eyebrow">{meta}</p>}
      <h1>{d.title}</h1>
      {d.comingSoon && <p class="soon" data-testid="coming-soon">{t(locale, 'comingSoon')}</p>}
      <p class="lead">{d.summary}</p>
    </header>
    <div class="grid">
      <article class="body">
        {d.problem && (
          <section><h2>{t(locale, 'theGoal')}</h2><p>{d.problem}</p></section>
        )}
        <section>
          <h2>{t(locale, 'whatIDid')}</h2>
          <ul class="hl">{d.highlights.map((h) => <li>{h}</li>)}</ul>
        </section>
        {d.type === 'package' && <h2>{t(locale, 'install')}</h2>}
        <div class="prose"><Content /></div>
        {d.metrics.length > 0 && (
          <section data-testid="results">
            <h2>{t(locale, 'results')}</h2>
            <ul class="metrics">{d.metrics.map((m) => <li><b>{m.value}</b><span>{m.label}</span></li>)}</ul>
          </section>
        )}
        {d.screenshots.length > 1 && (
          <div class="shots">{d.screenshots.slice(1).map((s) => <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />)}</div>
        )}
      </article>
      <aside class="side">
        <div class="card box">
          <h2>{t(locale, 'stack')}</h2>
          <ul class="chips">{d.stack.map((s) => <li>{s}</li>)}</ul>
        </div>
        {links.length > 0 && (
          <div class="card box">
            <h2>{t(locale, 'links')}</h2>
            <ul class="links" data-testid="project-links">
              {links.map(([k, url]) => <li><a href={url} target="_blank" rel="noopener">{t(locale, linkLabels[k])} <span class="flip" aria-hidden="true">↗</span></a></li>)}
            </ul>
          </div>
        )}
      </aside>
    </div>
    <nav class="pn" aria-label={t(locale, 'backToWork')}>
      {prev ? <a href={localizePath(`/work/${prev.data.slug}/`, locale)}><span>{t(locale, 'prevProject')}</span>{prev.data.title}</a> : <span></span>}
      {next && <a class="next" href={localizePath(`/work/${next.data.slug}/`, locale)}><span>{t(locale, 'nextProject')}</span>{next.data.title}</a>}
    </nav>
  </main>
  <Contact locale={locale} />
</Base>
<style>
  .cs { padding-block: 28px 8px; }
  .backlink { display: inline-flex; gap: 8px; color: var(--muted); font-size: 14px; margin-bottom: 18px; }
  .backlink:hover { color: var(--text); }
  .head { margin: 28px 0 8px; }
  h1 { font-size: clamp(34px, 5vw, 56px); letter-spacing: -.03em; margin: 8px 0 10px; }
  :global(html:lang(ar)) h1 { letter-spacing: 0; }
  .soon { display: inline-block; font-size: 13px; font-weight: 600; color: var(--ok); border: 1px solid color-mix(in srgb, var(--ok) 40%, transparent); border-radius: 999px; padding: 5px 12px; margin: 0 0 14px; }
  .lead { color: var(--muted); font-size: 18px; margin: 0; max-width: 680px; line-height: 1.6; }
  .grid > * { min-width: 0; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 40px; margin-top: 36px; align-items: start; }
  .body h2, .side h2 { font-size: 14px; color: var(--muted); text-transform: uppercase; letter-spacing: .1em; margin: 0 0 12px; font-weight: 600; }
  :global(html:lang(ar)) .body h2, :global(html:lang(ar)) .side h2 { letter-spacing: 0; }
  .body section { margin-bottom: 32px; }
  .body p, .prose :global(p) { font-size: 17px; line-height: 1.7; margin: 0 0 16px; }
  .hl { margin: 0; padding-inline-start: 20px; line-height: 1.7; font-size: 17px; display: grid; gap: 6px; }
  .prose :global(pre) { padding: 16px 18px; border-radius: 14px; overflow-x: auto; font-size: 14px; border: 1px solid var(--line); direction: ltr; text-align: left; }
  .metrics { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
  .metrics li { background: var(--panel); border: 1px solid var(--line); border-radius: 18px; padding: 16px; }
  .metrics b { display: block; font-size: 28px; }
  .metrics span { color: var(--muted); font-size: 14px; }
  .shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
  .shots img { width: 100%; border-radius: 16px; border: 1px solid var(--line); }
  .side { display: grid; gap: 14px; position: sticky; top: 84px; }
  .box { padding: 20px; }
  .links { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .links a { color: var(--accent); font-weight: 600; }
  .pn { display: flex; justify-content: space-between; gap: 12px; margin: 48px 0 0; padding-top: 24px; border-top: 1px solid var(--line); }
  .pn a { display: flex; flex-direction: column; gap: 2px; font-weight: 600; }
  .pn a span { font-size: 12px; color: var(--muted); font-weight: 400; }
  .pn .next { text-align: end; }
  @media (max-width: 899px) { .grid { grid-template-columns: 1fr; } .side { position: static; } }
</style>
