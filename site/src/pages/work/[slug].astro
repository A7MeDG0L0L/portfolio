---
import CaseStudy from '../../components/casestudy/CaseStudy.astro';
import { getProjects, hasCaseStudyPage, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = (await getProjects('en')).filter(hasCaseStudyPage);
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}
interface Props { project: Project }
const { project } = Astro.props;
---
<CaseStudy project={project} locale="en" />
